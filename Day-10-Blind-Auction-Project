from art import logo
print(logo)
# TODO-1: Ask the user for input
auction_bid_dict = {}
continue_bidding ="yes"
while continue_bidding == "yes":
    name = input("What is your name?")
    bid = int(input("What is your bid? $"))
    continue_bidding=input("Are their any other bidders? Type 'yes' or 'no'")
# TODO-2: Save data into dictionary {name: price}
    auction_bid_dict[name]=bid
# TODO-3: Whether if new bids need to be added
    if continue_bidding == 'yes':
        print("\n" * 20)
# TODO-4: Compare bids in dictionary
    highest_bid=0
    winner_name=""
    for key in auction_bid_dict:
        current_bid = auction_bid_dict[key]
        if current_bid > highest_bid:
            highest_bid = current_bid
            winner_name = key
print(f"The winner name is {winner_name} with the bid of ${highest_bid}")
