import random
from art import logo

print(logo)
print("Welcome to the Number Guessing Game!")
print("I'm thinking of a number between 1 and 100.")
chosen_number = random.randint(1,101)
user_difficulty = input("Choose a difficulty. Type 'easy' or 'hard':")
max_attempts = 0
if user_difficulty == "easy":
    max_attempts = 10
elif user_difficulty == "hard":
    max_attempts = 5
else :
    max_attempts = 5
    print("Invalid Choice. So difficulty level is set to easy.")


while max_attempts > 0:
    print(f"You have {max_attempts} attempts remaining to guess the number.")
    user_guess = int(input("Make a guess: "))
    if user_guess == chosen_number:
        print(f"You have guessed it right! Number is {chosen_number} ")
        is_game_over = True
        break
    elif user_guess < chosen_number:
        print("Too Low.\nGuess Again.")
    elif user_guess > chosen_number:
        print("Too High.\nGuess Again")
    max_attempts = max_attempts - 1

while max_attempts == 0:
    print("You've run out of guesses. Refresh the page to run again.")
    print("\n" * 30 )
