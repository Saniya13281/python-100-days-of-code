def add(n1, n2):
    return n1 + n2

def subtract(n1, n2):
    return n1 - n2

def mul(n1, n2):
    return n1 * n2

def div(n1, n2):
    return n1 / n2

operations ={
    "+":add,
    "-":subtract,
    "*":mul,
    "/":div,
}

def calculator():
    from art import logo
    print(logo)
    first_num = float(input("What's the first number?"))

    continue_calculating = True
    while continue_calculating:

        math_op = input(" +\n -\n *\n /\n Pick an operation:")
        second_num = float(input("What's the next number?"))
        result = operations[math_op](first_num,second_num)
        print(f"{first_num} {math_op} {second_num} = {result}")

        user = input(f"Type 'y' to continue calculating with {result}, or type 'n' to start a new calculation: ")

        if user == 'y':
            first_num = result
        else:
            continue_calculating = False
            print("\n" * 30)
            calculator()
calculator()
